{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3100/",
        "http://localhost:3200/",
        "http://localhost:3200/how-this-blog-works",
        "http://localhost:3300/",
        "http://localhost:3300/items/arcane_energize",
        "http://localhost:3300/vosfor",
        "http://localhost:3300/stash",
        "http://localhost:3300/sets",
        "http://localhost:3300/ducats",
        "http://localhost:3400/"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3[123]00/",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3400/",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
