{
  "name": "troules-sites",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "check": "turbo run lint typecheck test && pnpm format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && prettier --write \"**/CHANGELOG.md\" \"**/package.json\" >/dev/null",
    "prepare": "lefthook install",
    "lighthouse": "bash scripts/lighthouse.sh",
    "uptime": "bash scripts/uptime-probe.sh"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "0.15.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "2.11.10"
  }
}
